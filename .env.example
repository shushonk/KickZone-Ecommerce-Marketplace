# KickZone Environment Variables Template
# Copy this file to '.env' or '.env.local' and populate with your own keys.

# 1. AI Services
# GEMINI_API_KEY: Required for Gemini AI shopping assistant on server-side.
GEMINI_API_KEY=your_key_here

# 2. Database Services
# MONGODB_URI: Connection string for database persistence (if using MongoDB backend).
MONGODB_URI=your_mongodb_uri_here

# 3. Authentication Secrets
# JWT_SECRET: Secret phrase for signing and verifying user session tokens.
JWT_SECRET=your_jwt_secret_here

# 4. Host settings
# APP_URL: The hosting URL of the front-end or API layer.
APP_URL=https://your-domain.com
